# ============================================================================
# Cloudflare Pages custom headers
# https://developers.cloudflare.com/pages/configuration/headers/
# ============================================================================

# --------------------------------------------------------------------------
# Global — security hardening for every page
# --------------------------------------------------------------------------
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' static.cloudflareinsights.com unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# --------------------------------------------------------------------------
# HTML pages — short-lived cache, always revalidate
# --------------------------------------------------------------------------
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# --------------------------------------------------------------------------
# Hashed / versioned assets — long cache (MkDocs fingerprints these)
# --------------------------------------------------------------------------
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/search/*
  Cache-Control: public, max-age=0, must-revalidate

# --------------------------------------------------------------------------
# CSS & JS — moderate cache with revalidation
# --------------------------------------------------------------------------
/stylesheets/*
  Cache-Control: public, max-age=3600, must-revalidate

# --------------------------------------------------------------------------
# Early Hints — preload critical assets so the CDN can 103 them
# --------------------------------------------------------------------------
/
  Link: </stylesheets/shadcn.css>; rel=preload; as=style
/guide/*
  Link: </stylesheets/shadcn.css>; rel=preload; as=style
/reference/*
  Link: </stylesheets/shadcn.css>; rel=preload; as=style
