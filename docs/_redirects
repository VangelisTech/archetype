/quickstart       /guide/quickstart/          301
/start            /guide/quickstart/          301
/architecture     /guide/architecture/        301
/examples         /guide/examples/            301
/contributing     /guide/auto-merge/          301

# --------------------------------------------------------------------------
# GitHub convention — /docs often typed by contributors
# --------------------------------------------------------------------------
/docs             /                           301

